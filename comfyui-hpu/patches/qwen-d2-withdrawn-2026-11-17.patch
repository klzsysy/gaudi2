diff --git a/tests-unit/comfy_test/hpu_qwen21_prefix_test.py b/tests-unit/comfy_test/hpu_qwen21_prefix_test.py
new file mode 100644
index 00000000..e0646a8f
--- /dev/null
+++ b/tests-unit/comfy_test/hpu_qwen21_prefix_test.py
@@ -0,0 +1,150 @@
+import pytest
+import torch
+from torch._dynamo.backends.registry import lookup_backend
+
+import comfy.model_management
+import comfy.ops
+from comfy.cli_args import args
+from comfy.ldm.modules.attention import attention_pytorch
+from comfy.ldm.qwen_image21 import model as qwen
+
+
+class PrefixOperations(comfy.ops.manual_cast):
+    hpu_fp8 = True
+
+
+@pytest.fixture
+def hpu(monkeypatch):
+    if not hasattr(torch, 'hpu') or not torch.hpu.is_available():
+        pytest.skip('HPU required')
+    monkeypatch.setattr(args, 'disable_comfy_compiler', False)
+    monkeypatch.setattr(comfy.model_management, 'in_training', False)
+    monkeypatch.setattr(qwen, 'optimized_attention', attention_pytorch)
+    prefix_compiler = qwen._compiled_prefix_block
+    torch._dynamo.reset()
+    prefix_compiler.cache_clear()
+    yield
+    torch._dynamo.reset()
+    prefix_compiler.cache_clear()
+
+
+def inputs(device='hpu', length=8160, batch=1):
+    dtype = torch.bfloat16 if device == 'hpu' else torch.float32
+    block = qwen.QwenImage21TransformerBlock(128, 4, 32, dtype=dtype, device=device,
+                                            operations=PrefixOperations)
+    x = torch.zeros(batch, length, 128, device=device, dtype=dtype)
+    prefix = torch.zeros(batch, 5, 4, 32, device=device, dtype=dtype)
+    return block, x, prefix
+
+
+@pytest.mark.parametrize('index,enabled,expected', [(0, True, False), (1, True, True), (31, False, False)])
+def test_prefix_dispatch_preserves_first_layer_and_opt_out(hpu, monkeypatch, index, enabled, expected):
+    block, x, prefix = inputs()
+    calls = []
+
+    def compiled(*values):
+        calls.append(values)
+        return values[1]
+
+    monkeypatch.setattr(qwen, '_compiled_prefix_block', lambda: compiled)
+    options = dict(block_index=index, hpu_fast_attention=enabled)
+    with torch.no_grad():
+        output = block._forward_with_prefix(x, (), x, prefix, prefix, options)
+    assert output is x
+    assert calls[0][-1] is expected
+    assert calls[0][4] is prefix and calls[0][5] is prefix
+    assert options == dict(block_index=index, hpu_fast_attention=enabled)
+
+
+@pytest.mark.parametrize('reason', ['disabled', 'training', 'grad', 'hook', 'operations', 'length',
+                                   'batch', 'preferred', 'patch', 'replace', 'override', 'dtype'])
+def test_prefix_dispatch_bypasses_unsupported_context(hpu, monkeypatch, reason):
+    block, x, prefix = inputs(length=4096 if reason == 'length' else 8160,
+                              batch=2 if reason == 'batch' else 1)
+    options = {}
+    if reason == 'operations':
+        block.hpu_compile_prefix = False
+    if reason == 'preferred':
+        block.attn.comfy_attention.method = 'custom'
+    if reason == 'dtype':
+        x = x.float()
+    if reason == 'patch':
+        options['patches'] = {'attn1_patch': [object()]}
+    if reason == 'replace':
+        options['patches_replace'] = {'dit': {('single_block', 1): object()}}
+    if reason == 'override':
+        options['optimized_attention_override'] = object()
+    if reason == 'hook':
+        block.register_forward_hook(lambda *values: None)
+    monkeypatch.setattr(args, 'disable_comfy_compiler', reason == 'disabled')
+    monkeypatch.setattr(comfy.model_management, 'in_training', reason == 'training')
+    monkeypatch.setattr(qwen, '_compiled_prefix_block', lambda: pytest.fail('prefix compiler must be bypassed'))
+    received = []
+
+    def forward(*values):
+        received.append(values)
+        return values[0]
+
+    monkeypatch.setattr(block, 'forward', forward)
+    with torch.set_grad_enabled(reason == 'grad'):
+        output = block._forward_with_prefix(x, (), x, prefix, prefix, options)
+    assert output is x
+    assert received[0][-1] is options
+    assert received[0][-2] == 0
+
+
+def test_cpu_prefix_keeps_normal_entry(monkeypatch):
+    block, x, prefix = inputs(device='cpu', length=17)
+    monkeypatch.setattr(qwen, '_compiled_prefix_block', lambda: pytest.fail('HPU compiler on CPU'))
+    monkeypatch.setattr(block, 'forward', lambda x, *values: x)
+    with torch.no_grad():
+        assert block._forward_with_prefix(x, (), x, prefix, prefix, {}) is x
+
+
+def test_prefix_graph_reuses_lengths_and_recomputes_values_and_weights(hpu, monkeypatch):
+    torch.manual_seed(552)
+    backend = lookup_backend('hpu_backend')
+    graphs = []
+
+    def counted(graph, values, **kwargs):
+        graphs.append(graph)
+        return backend(graph, values, **kwargs)
+
+    compiled = torch.compile(qwen._prefix_block, backend=counted, dynamic=None,
+                             options={'force_static_compile': True})
+    monkeypatch.setattr(qwen, '_compiled_prefix_block', lambda: compiled)
+    with torch.no_grad():
+        block, x, _ = inputs()
+        for name, parameter in block.named_parameters():
+            parameter.copy_(torch.randn_like(parameter) * .03 + (1 if 'norm' in name else 0))
+        x.normal_()
+        mod = tuple((torch.randn(1, 1, 128, device='hpu', dtype=x.dtype) * .1,
+                     torch.randn(1, 1, 128, device='hpu', dtype=x.dtype) * .1) for _ in range(4))
+        mod += (torch.zeros(1, 1, 128, device='hpu', dtype=x.dtype),)
+        angle = torch.randn(1, 8160, 1, 16)
+        pe = torch.stack((angle.cos(), -angle.sin(), angle.sin(), angle.cos()), -1).reshape(1, 8160, 1, 16, 2, 2).to('hpu')
+        options = dict(hpu_fast_attention=True, block_index=1)
+        prefix_a = torch.randn(1, 5, 4, 32, device='hpu', dtype=x.dtype)
+
+        def run(prefix, value):
+            length = prefix.shape[1]
+            working = torch.cat([torch.zeros_like(x[:, :length]), x], dim=1)[:, length:]
+            positions = torch.cat([torch.zeros_like(pe[:, :length]), pe], dim=1)[:, length:]
+            key, value = torch.stack([prefix, value], dim=1).unbind(1)
+            output = block._forward_with_prefix(working, mod, positions, key, value, options)
+            assert output.data_ptr() == working.data_ptr()
+            return output.cpu()
+
+        original = run(prefix_a, prefix_a * .5)
+        changed = run(prefix_a * -.5, prefix_a * -2)
+        assert not torch.equal(original, changed)
+        for length in (7, 31, 32, 33, 63, 64, 65):
+            prefix = torch.randn(1, length, 4, 32, device='hpu', dtype=x.dtype)
+            assert run(prefix, prefix * .25).isfinite().all()
+        torch.testing.assert_close(run(prefix_a, prefix_a * .5), original, rtol=0, atol=0)
+        weight = block.attn.to_out[0].weight.clone()
+        block.attn.to_out[0].weight.mul_(.5)
+        assert not torch.equal(run(prefix_a, prefix_a * .5), original)
+        block.attn.to_out[0].weight.copy_(weight)
+        torch.testing.assert_close(run(prefix_a, prefix_a * .5), original, rtol=0, atol=0)
+    assert len(graphs) <= 6
