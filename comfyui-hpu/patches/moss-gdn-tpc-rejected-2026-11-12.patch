--- /dev/null
+++ b/scripts/gaudi/build_gdn.py
@@ -0,0 +1,33 @@
+"""Build the optional Gaudi2 deferred-state kernel with the active Habana SDK.
+
+Run with the same Python environment used by scripts/gaudi/start.sh.
+The startup script adds the built kernel library to GC_KERNEL_PATH.
+"""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+import habana_frameworks.torch
+from torch.utils.cpp_extension import load
+
+
+root = Path(__file__).resolve().parents[2]
+source = root / "comfy" / "text_encoders" / "hpu_gdn"
+build = root / "build" / "hpu"
+build.mkdir(parents=True, exist_ok=True)
+compiler = shutil.which("tpc-clang") or "/opt/habanalabs/bin/tpc-clang"
+subprocess.run([compiler, "-march=gaudi2", "-O2", "-c", str(source / "core.c"), "-o", str(build / "gdn.o")], check=True)
+(build / "gdn.S").write_text(
+    '.section .rodata\n.global gdn_start\n.global gdn_end\ngdn_start:\n'
+    f'.incbin "{build}/gdn.o"\ngdn_end:\n.section .note.GNU-stack,"",@progbits\n')
+subprocess.run(["g++", "-fPIC", "-c", str(build / "gdn.S"), "-o", str(build / "gdn-blob.o")], check=True)
+subprocess.run(["g++", "-shared", "-fPIC", "-O2", "-I/usr/include/habanalabs", str(source / "glue.cpp"),
+                str(build / "gdn-blob.o"), "-o", str(build / "libcomfy_gdn_tpc.so")], check=True)
+package = Path(habana_frameworks.torch.__file__).parent
+os.environ.setdefault("MAX_JOBS", "2")
+load(name="comfy_gdn_bridge", sources=[str(source / "bridge.cpp")], build_directory=str(build),
+     extra_include_paths=[str(package / "include")],
+     extra_ldflags=[f'-L{package / "lib"}', "-lhabana_pytorch2_plugin", f'-Wl,-rpath,{package / "lib"}'],
+     is_python_module=False, verbose=True)
+print(f"Built Gaudi2 GDN kernel in {build}")
diff --git a/comfy/text_encoders/hpu_gdn/__init__.py b/comfy/text_encoders/hpu_gdn/__init__.py
new file mode 100644
--- /dev/null
+++ b/comfy/text_encoders/hpu_gdn/__init__.py
@@ -0,0 +1,37 @@
+"""Optional Gaudi2 FP32 deferred-state kernel, built by scripts/gaudi/build_gdn.py."""
+import logging
+import os
+from pathlib import Path
+
+import torch
+
+
+build = Path(__file__).resolve().parents[3] / "build" / "hpu"
+kernel_library = build / "libcomfy_gdn_tpc.so"
+kernel_paths = os.environ.get("GC_KERNEL_PATH", "").split(":")
+available = False
+if (hasattr(torch, "hpu") and kernel_library.is_file()
+        and any(Path(path).resolve() == kernel_library for path in kernel_paths if path)):
+    try:
+        torch.ops.load_library(str(build / "comfy_gdn_bridge.so"))
+        available = True
+    except OSError as error:
+        logging.warning("HPU GDN extension could not be loaded. Rebuild with scripts/gaudi/build_gdn.py. %s", error)
+
+
+def metadata(state, pk, pv, pd, pb, q, k, v, d, b, program):
+    return torch.empty_like(state), state.new_empty((state.shape[0], q.shape[2], state.shape[1], state.shape[2]))
+
+
+if available:
+    torch.library.register_fake("custom_op::comfy_gdn_core")(metadata)
+
+
+def core(state, pk, pv, pd, pb, q, k, v, d, b, program, pending):
+    control = torch.cat((program.to(torch.int32), pending.reshape(1).to(torch.int32)))
+    committed, output = torch.ops.custom_op.comfy_gdn_core(
+        state.transpose(-1, -2).contiguous(), pk.transpose(-1, -2).contiguous(), pv.transpose(-1, -2).contiguous(),
+        pd.transpose(1, 2).contiguous(), pb.transpose(1, 2).contiguous(), q.transpose(-1, -2).contiguous(),
+        k.transpose(-1, -2).contiguous(), v.transpose(-1, -2).contiguous(), d.transpose(1, 2).contiguous(),
+        b.transpose(1, 2).contiguous(), control)
+    return committed.transpose(-1, -2).contiguous(), output
diff --git a/comfy/text_encoders/hpu_gdn/bridge.cpp b/comfy/text_encoders/hpu_gdn/bridge.cpp
new file mode 100644
--- /dev/null
+++ b/comfy/text_encoders/hpu_gdn/bridge.cpp
@@ -0,0 +1,23 @@
+#include <torch/library.h>
+#include <ATen/ATen.h>
+#include <hpu_custom_op_pt2.h>
+
+habana::PartialOutputMetaDataVector metadata(const at::Stack& stack) {
+    const auto state = stack.at(0).toTensor();
+    const auto query = stack.at(5).toTensor();
+    return {{at::kFloat, state.sizes().vec()}, {at::kFloat, {state.size(0), query.size(2), state.size(1), state.size(2)}}};
+}
+
+std::tuple<at::Tensor, at::Tensor> execute(const at::Tensor& state, const at::Tensor& pk, const at::Tensor& pv,
+    const at::Tensor& pd, const at::Tensor& pb, const at::Tensor& q, const at::Tensor& k,
+    const at::Tensor& v, const at::Tensor& d, const at::Tensor& b, const at::Tensor& program) {
+    auto op = habana::custom_op::UserCustomOpDescriptor::getUserCustomOpDescriptor("custom_op::comfy_gdn_core");
+    auto result = op.execute({state, pk, pv, pd, pb, q, k, v, d, b, program});
+    return {result[0], result[1]};
+}
+
+TORCH_LIBRARY_FRAGMENT(custom_op, library) {
+    library.def("comfy_gdn_core(Tensor state, Tensor pk, Tensor pv, Tensor pd, Tensor pb, Tensor q, Tensor k, Tensor v, Tensor d, Tensor b, Tensor program) -> (Tensor, Tensor)");
+    habana::custom_op::registerUserCustomOp("custom_op::comfy_gdn_core", "comfy_gdn_core_f32", metadata, nullptr);
+}
+TORCH_LIBRARY_IMPL(custom_op, HPU, library) { library.impl("comfy_gdn_core", execute); }
diff --git a/comfy/text_encoders/hpu_gdn/core.c b/comfy/text_encoders/hpu_gdn/core.c
new file mode 100644
--- /dev/null
+++ b/comfy/text_encoders/hpu_gdn/core.c
@@ -0,0 +1,111 @@
+// Broadcast a tensor scalar through the vector pipeline.
+float64 first_group(float64 x) {
+    const int writes = SW_WR_LOWER_GROUP0 | SW_WR_UPPER_GROUP0 | SW_WR_LOWER_GROUP1 | SW_WR_UPPER_GROUP1 |
+                       SW_WR_LOWER_GROUP2 | SW_WR_UPPER_GROUP2 | SW_WR_LOWER_GROUP3 | SW_WR_UPPER_GROUP3;
+    return v_f32_mov_dual_group_all_b(x, 0xffffffff, 0, 0, 0, 0, writes, 0);
+}
+__local__ float64 pk_cache[8][2], k_cache[8][2], q_cache[8][2];
+
+// One index-space member owns four value columns of one FP32 recurrent state.
+void main(tensor state, tensor previous_key, tensor previous_value,
+          tensor previous_decay, tensor previous_beta, tensor query, tensor key,
+          tensor value, tensor decay, tensor beta, tensor program,
+          tensor committed, tensor output, int values, int heads, int batches,
+          int previous_rows, int rows) {
+    const int5 begin = get_index_space_offset();
+    const int5 end = begin + get_index_space_size();
+    int instructions[8];
+    for (int order = 0; order < rows; ++order) {
+        int5 position = {order, 0, 0, 0, 0};
+        instructions[order] = s_i32_ld_g((__global__ int*)gen_addr(position, program));
+    }
+    int5 count_position = {rows, 0, 0, 0, 0};
+    previous_rows = s_i32_ld_g((__global__ int*)gen_addr(count_position, program));
+    for (int batch = begin[2]; batch < end[2] && batch < batches; ++batch) {
+        for (int head = begin[1]; head < end[1] && head < heads; ++head) {
+            int5 gate_position = {0, head, batch, 0, 0};
+            float64 previous_decays = first_group(v_f32_ld_tnsr_b(gate_position, previous_decay));
+            float64 previous_betas = first_group(v_f32_ld_tnsr_b(gate_position, previous_beta));
+            float64 decays = first_group(v_f32_ld_tnsr_b(gate_position, decay));
+            float64 betas = first_group(v_f32_ld_tnsr_b(gate_position, beta));
+            for (int row = 0; row < previous_rows; ++row) {
+                for (int part = 0; part < 2; ++part) {
+                    int5 key_position = {part * 64, row, head, batch, 0};
+                    pk_cache[row][part] = v_f32_ld_tnsr_b(key_position, previous_key);
+                }
+            }
+            for (int row = 0; row < rows; ++row) {
+                for (int part = 0; part < 2; ++part) {
+                    int5 key_position = {part * 64, row, head, batch, 0};
+                    k_cache[row][part] = v_f32_ld_tnsr_b(key_position, key);
+                    q_cache[row][part] = v_f32_ld_tnsr_b(key_position, query);
+                }
+            }
+            for (int block = begin[0]; block < end[0]; ++block) {
+                float64 first[4], second[4];
+                #pragma unroll
+                for (int lane = 0; lane < 4; ++lane) {
+                    int5 position = {0, block * 4 + lane, head, batch, 0};
+                    first[lane] = v_f32_ld_tnsr_b(position, state);
+                    position[0] = 64;
+                    second[lane] = v_f32_ld_tnsr_b(position, state);
+                }
+                for (int row = 0; row < previous_rows; ++row) {
+                    float64 d = v_f32_shuffle_b(previous_decays, (unsigned char)(128 + row), 0, 0);
+                    float64 b = v_f32_shuffle_b(previous_betas, (unsigned char)(128 + row), 0, 0);
+                    int5 value_position = {block * 4, row, head, batch, 0};
+                    float64 value_group = first_group(v_f32_ld_tnsr_b(value_position, previous_value));
+                    float64 k0 = pk_cache[row][0];
+                    float64 k1 = pk_cache[row][1];
+                    #pragma unroll
+                    for (int lane = 0; lane < 4; ++lane) {
+                        float64 v = v_f32_shuffle_b(value_group, (unsigned char)(128 + lane), 0, 0);
+                        first[lane] *= d;
+                        second[lane] *= d;
+                        float64 prediction = v_f32_reduce_add(first[lane] * k0 + second[lane] * k1);
+                        float64 update = (v - prediction) * b;
+                        first[lane] += k0 * update;
+                        second[lane] += k1 * update;
+                    }
+                }
+                #pragma unroll
+                for (int lane = 0; lane < 4; ++lane) {
+                    int5 position = {0, block * 4 + lane, head, batch, 0};
+                    v_f32_st_tnsr(position, committed, first[lane]);
+                    position[0] = 64;
+                    v_f32_st_tnsr(position, committed, second[lane]);
+                }
+                for (int order = 0; order < rows; ++order) {
+                    // Low four bits select the row. Bit 5 advances the working state.
+                    int instruction = instructions[order];
+                    int row = instruction & 15;
+                    float64 d = v_f32_shuffle_b(decays, (unsigned char)(128 + row), 0, 0);
+                    float64 b = v_f32_shuffle_b(betas, (unsigned char)(128 + row), 0, 0);
+                    int5 value_position = {block * 4, row, head, batch, 0};
+                    float64 value_group = first_group(v_f32_ld_tnsr_b(value_position, value));
+                    float64 k0 = k_cache[row][0];
+                    float64 q0 = q_cache[row][0];
+                    float64 k1 = k_cache[row][1];
+                    float64 q1 = q_cache[row][1];
+                    #pragma unroll
+                    for (int lane = 0; lane < 4; ++lane) {
+                        float64 v = v_f32_shuffle_b(value_group, (unsigned char)(128 + lane), 0, 0);
+                        float64 next_first = first[lane] * d;
+                        float64 next_second = second[lane] * d;
+                        float64 prediction = v_f32_reduce_add(next_first * k0 + next_second * k1);
+                        float64 update = (v - prediction) * b;
+                        next_first += k0 * update;
+                        next_second += k1 * update;
+                        float64 result = v_f32_reduce_add(next_first * q0 + next_second * q1);
+                        int5 output_position = {block * 4 + lane, head, row, batch, 0};
+                        v_f32_st_tnsr_partial(output_position, output, result, 0, 0);
+                        if (instruction & 32) {
+                            first[lane] = next_first;
+                            second[lane] = next_second;
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/comfy/text_encoders/hpu_gdn/glue.cpp b/comfy/text_encoders/hpu_gdn/glue.cpp
new file mode 100644
--- /dev/null
+++ b/comfy/text_encoders/hpu_gdn/glue.cpp
@@ -0,0 +1,57 @@
+#include <tpc_kernel_lib_interface.h>
+#include <cstring>
+#include <cstdint>
+
+using namespace tpc_lib_api;
+extern "C" const unsigned char gdn_start[], gdn_end[];
+const char* guid = "comfy_gdn_core_f32";
+
+extern "C" uint64_t GetLibVersion() { return 1; }
+extern "C" GlueCodeReturn GetKernelGuids(DeviceId device, uint32_t* count, GuidInfo* guids) {
+    const uint32_t capacity = *count;
+    *count = device == DEVICE_ID_GAUDI2 ? 1 : 0;
+    if (guids && capacity && *count) {
+        std::memset(guids, 0, sizeof(GuidInfo));
+        std::strcpy(guids[0].name, guid);
+    }
+    return GLUE_SUCCESS;
+}
+extern "C" GlueCodeReturn GetShapeInference(DeviceId device, const ShapeInferenceParams* p, ShapeInferenceOutput* out) {
+    if (device != DEVICE_ID_GAUDI2 || std::strcmp((p->pGuid ? p->pGuid : &p->guid)->name, guid)) return GLUE_NODE_NOT_FOUND;
+    out->outputTensors[0]->geometry = p->inputTensors[0]->geometry;
+    auto& shape = out->outputTensors[1]->geometry;
+    shape = p->inputTensors[0]->geometry;
+    shape.maxSizes[0] = shape.minSizes[0] = p->inputTensors[0]->geometry.maxSizes[1];
+    shape.maxSizes[1] = shape.minSizes[1] = p->inputTensors[0]->geometry.maxSizes[2];
+    shape.maxSizes[2] = shape.minSizes[2] = p->inputTensors[5]->geometry.maxSizes[1];
+    return GLUE_SUCCESS;
+}
+extern "C" GlueCodeReturn InstantiateTpcKernel(const HabanaKernelParams* p, HabanaKernelInstantiation* out) {
+    if (p->deviceId != DEVICE_ID_GAUDI2 || std::strcmp(p->guid.name, guid)) return GLUE_NODE_NOT_FOUND;
+    if (p->inputTensorNr != 11 || p->outputTensorNr != 2) return GLUE_UNSUPPORTED_LAYER_CONFIGURATION;
+    const auto& state = p->inputTensors[0].geometry;
+    if (state.dataType != DATA_F32 || state.dims != 4 || state.maxSizes[0] != 128) return GLUE_INCOMPATIBLE_INPUT_SIZE;
+    const int parameters[] = {int(state.maxSizes[1]), int(state.maxSizes[2]), int(state.maxSizes[3]),
+                              int(p->inputTensors[1].geometry.maxSizes[1]), int(p->inputTensors[5].geometry.maxSizes[1])};
+    if (parameters[3] > 8 || parameters[4] > 8) return GLUE_UNSUPPORTED_LAYER_CONFIGURATION;
+    out->indexSpaceRank = 3;
+    for (unsigned i = 0; i < 3; ++i) out->indexSpaceGeometry[i] = parameters[i];
+    out->indexSpaceGeometry[0] = (parameters[0] + 3) / 4;
+    out->auxiliaryTensorNr = 0;
+    for (unsigned i = 0; i < p->inputTensorNr; ++i) {
+        std::memset(&out->inputTensorAccessPattern[i], 0, sizeof(TensorAccessPattern));
+        out->inputTensorAccessPattern[i].allRequired = 1;
+    }
+    for (unsigned i = 0; i < p->outputTensorNr; ++i) {
+        std::memset(&out->outputTensorAccessPattern[i], 0, sizeof(TensorAccessPattern));
+        out->outputTensorAccessPattern[i].allRequired = 1;
+        out->outputTensorAccessPattern[i].noRmwAccess = 1;
+    }
+    std::memcpy(out->kernel.scalarParams, parameters, sizeof(parameters));
+    out->kernel.paramsNr = 5;
+    const uint32_t capacity = out->kernel.elfSize;
+    out->kernel.elfSize = gdn_end - gdn_start;
+    if (!out->kernel.kernelElf || capacity < out->kernel.elfSize) return GLUE_INSUFFICIENT_ELF_BUFFER;
+    std::memcpy(out->kernel.kernelElf, gdn_start, out->kernel.elfSize);
+    return GLUE_SUCCESS;
+}
